  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/DylanHalstead/pi-extensions/tree/main/extensions/model-switch-guard#readme",
  "bugs": {
    "url": "https://github.com/DylanHalstead/pi-extensions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DylanHalstead/pi-extensions.git",
    "directory": "extensions/model-switch-guard"
  },
  "files": [
    "src/index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp -C ../.. check extensions/model-switch-guard",
