{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "build": "pnpm --recursive --if-present run build",
    "verify": "pnpm build && pnpm check && pnpm test",
    "check": "vp check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
